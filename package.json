{
  "name": "yonaco",
  "displayName": "Yona Issue Tracker",
  "description": "Yona issue tracker and code review integration for VS Code",
  "version": "0.2.0",
  "publisher": "yonaprojects",
  "private": true,
  "license": "Apache-2.0",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/yona-projects/yonaco.git"
  },
  "homepage": "https://github.com/yona-projects/yonaco",
  "bugs": {
    "url": "https://github.com/yona-projects/yonaco/issues"
  },
  "keywords": [
    "yona",
    "issue-tracker",
    "code-review",
    "pull-request"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "yona",
          "title": "Yona",
          "icon": "media/activitybar-icon.png"
        }
      ]
    },
    "views": {
      "yona": [
        {
          "id": "yona.myIssues",
          "name": "내 이슈"
        }
      ]
    },
    "commands": [
      {
        "command": "yona.issue.create",
        "title": "Yona: 새 이슈",
        "icon": "$(add)"
      },
      {
        "command": "yona.server.add",
        "title": "Yona: 서버 등록"
      },
      {
        "command": "yona.auth.login",
        "title": "Yona: 로그인 (토큰)"
      },
      {
        "command": "yona.connectionTest",
        "title": "Yona: 연결 테스트"
      },
      {
        "command": "yona.server.switch",
        "title": "Yona: 서버 전환 / 추가",
        "icon": "$(server)"
      },
      {
        "command": "yona.myIssues.refresh",
        "title": "새로고침",
        "icon": "$(refresh)"
      },
      {
        "command": "yona.project.add",
        "title": "Yona: 프로젝트 등록"
      },
      {
        "command": "yona.issue.createFromLine",
        "title": "Yona: 이 라인으로 이슈 생성"
      },
      {
        "command": "yona.project.remove",
        "title": "프로젝트 목록에서 제거",
        "icon": "$(trash)"
      },
      {
        "command": "yona.openInBrowser",
        "title": "브라우저에서 열기",
        "icon": "$(link-external)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "yona.issue.create",
          "when": "view == yona.myIssues && yona.hasServer && yona.hasToken && yona.hasProject",
          "group": "navigation@1"
        },
        {
          "command": "yona.myIssues.refresh",
          "when": "view == yona.myIssues",
          "group": "navigation@2"
        },
        {
          "command": "yona.server.switch",
          "when": "view == yona.myIssues",
          "group": "navigation@3"
        },
        {
          "command": "yona.project.add",
          "when": "view == yona.myIssues && yona.hasServer",
          "group": "1_manage"
        }
      ],
      "editor/context": [
        {
          "command": "yona.issue.createFromLine",
          "group": "yona"
        }
      ],
      "view/item/context": [
        {
          "command": "yona.issue.create",
          "when": "view == yona.myIssues && viewItem == yona.project",
          "group": "inline@0"
        },
        {
          "command": "yona.openInBrowser",
          "when": "view == yona.myIssues && (viewItem == yona.issue || viewItem == yona.project)",
          "group": "inline@1"
        },
        {
          "command": "yona.project.remove",
          "when": "view == yona.myIssues && viewItem == yona.project",
          "group": "inline@2"
        },
        {
          "command": "yona.openInBrowser",
          "when": "view == yona.myIssues && (viewItem == yona.issue || viewItem == yona.project)",
          "group": "navigation@1"
        },
        {
          "command": "yona.project.remove",
          "when": "view == yona.myIssues && viewItem == yona.project",
          "group": "navigation@2"
        },
        {
          "command": "yona.issue.create",
          "when": "view == yona.myIssues && viewItem == yona.project",
          "group": "navigation@0"
        }
      ]
    },
    "configuration": {
      "title": "Yona",
      "properties": {
        "yona.servers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "등록된 Yona 서버 URL 목록"
        },
        "yona.currentServer": {
          "type": "string",
          "description": "현재 선택된 Yona 서버 URL"
        },
        "yona.projects": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "등록된 프로젝트 목록 (\"owner/name\" 형식)"
        }
      }
    },
    "viewsWelcome": [
      {
        "view": "yona.myIssues",
        "contents": "Yona 서버가 아직 등록되지 않았습니다.\n[서버 등록](command:yona.server.add)",
        "when": "!yona.hasServer"
      },
      {
        "view": "yona.myIssues",
        "contents": "서버에 로그인할 토큰이 필요합니다. Yona의 설정 화면에서 개인 액세스 토큰을 만든 뒤 입력하세요.\n[토큰으로 로그인](command:yona.auth.login)\n[다른 서버로 전환 / 추가](command:yona.server.switch)",
        "when": "yona.hasServer && !yona.hasToken"
      },
      {
        "view": "yona.myIssues",
        "contents": "표시할 프로젝트를 등록하세요 (owner/name 형식).\n[프로젝트 등록](command:yona.project.add)\n[연결 테스트](command:yona.connectionTest)",
        "when": "yona.hasServer && yona.hasToken && !yona.hasProject"
      }
    ]
  },
  "scripts": {
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "node esbuild.js --production",
    "vscode:prepublish": "npm run package",
    "lint": "eslint src",
    "pretest": "npm run compile && tsc --noEmit -p ./",
    "test:unit": "mocha --require ts-node/register --extensions ts \"test/unit/**/*.test.ts\"",
    "compile-tests": "tsc -p ./",
    "test:integration": "npm run compile && npm run compile-tests && vscode-test",
    "test": "npm run test:unit"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.7",
    "@types/node": "^20.14.0",
    "@types/sinon": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "@typescript-eslint/eslint-plugin": "^7.14.0",
    "@typescript-eslint/parser": "^7.14.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.21.5",
    "eslint": "^8.57.0",
    "mocha": "^10.4.0",
    "prettier": "^3.3.2",
    "sinon": "^18.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.2"
  },
  "dependencies": {
    "marked": "18.0.14"
  }
}
